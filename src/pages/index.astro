---
import Layout from '../layouts/Layout.astro';

const K = {
  tel: '+385 95 351 8960',
  telHref: 'tel:+385953518960',
  wa: '+386 64 264 500',
  waHref: 'https://wa.me/38664264500',
  mail: 'mbmetamont@gmail.com',
  sati: 'Svaki dan, 6:00 – 22:00',
  mjesto: 'Rijeka',
  podrucje: 'Rijeka i okolica',
};

import { SIRINE, remoteUrl, lokalnoPostoji } from '../data/slike.mjs';

// Fotografije: popis je u src/data/slike.json. Nakon "npm install" spremaju se u public/img
// i tada se koriste lokalne datoteke. Ako lokalnih nema, učitavaju se s Unsplasha/Pexelsa.
// Web3Forms: upiti stižu na mbmetamont@gmail.com
const WEB3FORMS_KEY = 'a5957fd6-d805-43af-a93d-6f8d614d95f0';

const pic = (name: string) => {
  const local = lokalnoPostoji(process.cwd(), name);
  const url = (w: number) => (local ? `/img/${name}-${w}.jpg` : remoteUrl(name, w));
  return { src: url(1200), srcset: SIRINE.map((w) => `${url(w)} ${w}w`).join(', ') };
};

const usluge = [
  { id: 'postavljanje', img: 'postavljanje', alt: 'Parketar postavlja pod', naslov: 'Postavljanje parketa',
    tekst: 'Postavljanje parketa u stanovima, kućama i poslovnim prostorima.',
    tagovi: ['Stanovi i kuće', 'Poslovni prostori'] },
  { id: 'brusenje', img: 'brusenje', alt: 'Brusilica i brusni papir na drvu', naslov: 'Brušenje parketa',
    tekst: 'Brušenje skida stari lak, mrlje i ogrebotine i priprema pod za novu završnu obradu.',
    tagovi: ['Skidanje starog laka', 'Uklanjanje ogrebotina'] },
  { id: 'lakiranje', img: 'lak', alt: 'Valjci za nanošenje na drvenom podu', naslov: 'Lakiranje',
    tekst: 'Novi lak štiti parket u svakodnevnoj upotrebi i vraća mu lijep izgled.',
    tagovi: ['Zaštita drva', 'Nakon brušenja'] },
  { id: 'popravci', img: 'popravci', alt: 'Alat za popravke na drvenoj podlozi', naslov: 'Popravci',
    tekst: 'Popravak oštećenih dijelova parketa, bez zamjene cijelog poda.',
    tagovi: ['Oštećena mjesta', 'Bez zamjene poda'] },
  { id: 'stepenice', img: 'stepenice', alt: 'Drvene stepenice uz bijeli zid', naslov: 'Drvene stepenice',
    tekst: 'Parketarski radovi na drvenim stepenicama.',
    tagovi: ['Stepenice u kućama i stanovima'] },
  { id: 'laminat', img: 'laminat', alt: 'Dnevni boravak sa svijetlim podom', naslov: 'Laminat',
    tekst: 'Postavljanje laminata u stambenim i poslovnim prostorima.',
    tagovi: ['Stanovi i kuće', 'Poslovni prostori'] },
  { id: 'beton', img: 'beton', alt: 'Prostor s betonskim podom i zidovima', naslov: 'Priprema betona',
    tekst: 'Priprema betonske podloge prije postavljanja parketa ili laminata.',
    tagovi: ['Podloga za parket', 'Podloga za laminat'] },
];

const razlozi = [
  { b: 'Brz odaziv', s: 'Na upit odgovaramo brzo, telefonom ili porukom.' },
  { b: 'Kvalitetan rad', s: 'Od pripreme podloge do završnog laka.' },
  { b: 'Vlasnik radi osobno', s: 'Radove izvodi vlasnik, a na većim objektima uz dodatnu pomoć.' },
  { b: 'Dostupni svaki dan', s: 'Pozivi svaki dan od 6 do 22 sata.' },
];

const koraci = [
  { h: 'Javite se', p: 'Nazovite ili pošaljite poruku, po mogućnosti s nekoliko fotografija prostora.' },
  { h: 'Dogovor', p: 'Dogovaramo vrstu radova, rok i cijenu.' },
  { h: 'Izvođenje radova', p: 'Radove izvodimo prema dogovoru.' },
  { h: 'Primopredaja', p: 'Zajedno pregledamo izvedene radove.' },
];

const pitanja = [
  { q: 'Na kojem području radite?', a: 'Radimo u Rijeci i okolici te na području Primorsko-goranske županije.' },
  { q: 'Koje radove izvodite?', a: 'Postavljanje, brušenje, lakiranje i popravke parketa, radove na drvenim stepenicama, postavljanje laminata i pripremu betonske podloge.' },
  { q: 'Može li se stari parket obnoviti?', a: 'Stari parket najčešće se može obnoviti brušenjem i novim lakom, a oštećena mjesta popraviti. Koliko je obnova moguća, vidi se na licu mjesta.' },
  { q: 'Koliko košta?', a: 'Cijena ovisi o vrsti radova, površini i stanju poda, pa se dogovara za svaki posao posebno.' },
  { q: 'Radite li i veće objekte?', a: 'Da. Na većim objektima radove izvodimo uz dodatnu pomoć.' },
  { q: 'Kada vas mogu nazvati?', a: 'Svaki dan od 6 do 22 sata. Poruku na WhatsApp ili e-mail možete poslati bilo kada.' },
];

const opcije = [
  ['postavljanje', 'Postavljanje parketa'], ['brusenje', 'Brušenje parketa'], ['lakiranje', 'Lakiranje'], ['popravci', 'Popravci'],
  ['stepenice', 'Drvene stepenice'], ['laminat', 'Laminat'], ['beton', 'Priprema betona'], ['ne-znam', 'Još ne znam'],
];

const izbornik = [
  ['#usluge', 'Usluge'], ['#prije', 'Prije i poslije'], ['#kako', 'Kako radimo'], ['#onama', 'O nama'], ['#pitanja', 'Pitanja'], ['#kontakt', 'Kontakt'],
];

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const phoneIco = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>';
const waIco = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2s.2-1.1.2-1.2-.2-.2-.5-.3z"/></svg>';
const mailIco = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14"/><path d="m3 7 9 6 9-6"/></svg>';
---
<Layout
  title="MB Metamont · Parketarski radovi Rijeka"
  description="Parketarski radovi u Rijeci i Primorsko-goranskoj županiji: postavljanje, brušenje, lakiranje i popravci parketa, drvene stepenice, laminat i priprema betona."
>
  <div class="intro" aria-hidden="true">
    <img class="m" src="/logo/mark-light.svg" alt="" />
    <div class="ln"></div>
    <img class="w" src="/logo/word-light.svg" alt="" />
  </div>

  <header class="nav"><div class="wrap"><div class="bar">
    <a class="logo" href="/" aria-label="MB Metamont"><img src="/logo/logo-h.svg" alt="MB Metamont parket" width="250" height="37" /></a>
    <nav class="menu" aria-label="Glavni izbornik">
      {izbornik.map(([h, t]) => <a href={h}>{t}</a>)}
    </nav>
    <a class="btn btn-p" href="#upit">Zatražite ponudu</a>
    <button class="burger" aria-label="Izbornik" aria-expanded="false"><span></span><span></span></button>
  </div></div></header>
  <div class="mnav">
    {izbornik.map(([h, t]) => <a href={h}>{t}</a>)}
    <a class="btn btn-p" href="#upit">Zatražite ponudu</a>
  </div>

  <main>
    <!-- HERO -->
    <section class="hero"><div class="wrap"><div class="grid">
      <div>
        <div class="eyebrow rv">Parketarski radovi · {K.mjesto}</div>
        <h1 class="rv" style="--d:.08s">Stari parket.<br /><em>Kao nov.</em></h1>
        <p class="lead rv" style="--d:.16s">Postavljanje, brušenje, lakiranje i popravci parketa, drvene stepenice, laminat i priprema betona. Rijeka i Primorsko-goranska županija.</p>
        <div class="cta rv" style="--d:.24s">
          <a class="btn btn-p" href="#upit">Zatražite ponudu <span class="arr" set:html={arrow} /></a>
          <a class="btn btn-l" href="#usluge">Pogledajte usluge</a>
        </div>
        <div class="quick rv" style="--d:.32s">
          <a href={K.telHref}><i set:html={phoneIco} /><span><small>Pozivi 6 – 22 h</small><b>{K.tel}</b></span></a>
          <a href={K.waHref} target="_blank" rel="noopener"><i set:html={waIco} /><span><small>WhatsApp</small><b>{K.wa}</b></span></a>
        </div>
      </div>
      <div class="vis rv" style="--d:.2s">
        <div class="ph1"><img {...pic('hero')} sizes="(max-width:960px) 100vw, 560px" alt="Drveni pod u prostranom stanu" fetchpriority="high" decoding="async" /></div>
        <div class="ph2"><img {...pic('stepenice')} sizes="240px" alt="Drvene stepenice" loading="lazy" decoding="async" /></div>
        <div class="badge"><span class="dot"></span><div><b>Dostupni svaki dan</b><span>od 6 do 22 sata</span></div></div>
      </div>
    </div></div></section>

    <div class="tickw" aria-hidden="true"><div class="ticker"><div class="tr">
      {[0, 1].map(() => usluge.map((u) => <span>{u.naslov}</span>))}
    </div></div></div>

    <!-- USLUGE -->
    <section class="sec" id="usluge"><div class="wrap">
      <div class="head-row">
        <div class="head rv">
          <div class="eyebrow">Usluge</div>
          <h2>Sve oko poda, <em>na jednom mjestu.</em></h2>
        </div>
        <p class="lead rv" style="--d:.1s">Od pripreme betonske podloge do postavljanja, brušenja i lakiranja parketa.</p>
      </div>
      <div class="bento">
        {usluge.map((u, i) => (
          <a class="svc rv" href="#upit" data-usluga={u.id} style={`--d:${(i % 4) * 0.08}s`}>
            <img {...pic(u.img)} sizes={i === 0 ? '(max-width:1000px) 100vw, 620px' : '(max-width:600px) 100vw, (max-width:1000px) 50vw, 310px'} alt={u.alt} loading="lazy" decoding="async" />
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="go" set:html={arrow} />
            <div class="tx"><h3>{u.naslov}</h3><p>{u.tekst}</p></div>
          </a>
        ))}
        <div class="svc svc-cta rv">
          <small>Niste sigurni što vam treba?</small>
          <h3>Javite se i opišite prostor. Dogovorit ćemo ostalo.</h3>
          <a class="btn" href="#upit">Pošaljite upit <span class="arr" set:html={arrow} /></a>
        </div>
      </div>
    </div></section>

    <!-- PRIJE / POSLIJE -->
    <section class="sec" id="prije" style="padding-top:0"><div class="wrap"><div class="bawrap">
      <div class="ba rv">
        <img {...pic('poslije')} sizes="(max-width:900px) 100vw, 700px" alt="Drveni pod nakon obrade" loading="lazy" decoding="async" />
        <div class="b4"><img {...pic('prije')} sizes="(max-width:900px) 100vw, 700px" alt="Istrošen drveni pod" loading="lazy" decoding="async" /></div>
        <div class="hdl"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" /></svg></i></div>
        <input type="range" min="0" max="100" value="50" step="0.5" aria-label="Usporedba prije i poslije" />
        <span class="lb l">Prije</span><span class="lb r">Poslije</span>
      </div>
      <div class="rv" style="--d:.1s">
        <div class="eyebrow">Prije i poslije</div>
        <h2>Isti pod. <em>Nakon obrade.</em></h2>
        <p class="lead">Povucite klizač i usporedite. Brušenje i novi lak potpuno mijenjaju izgled istrošenog poda.</p>
        <ul class="bal">
          <li>Brušenje skida stari lak i ogrebotine</li>
          <li>Novi lak štiti drvo</li>
          <li>Bez zamjene cijelog poda</li>
        </ul>
        <a class="btn btn-d" href="#upit" data-usluga="brusenje">Zatražite ponudu <span class="arr" set:html={arrow} /></a>
      </div>
    </div></div></section>

    <!-- ZAŠTO -->
    <section id="zasto"><div class="wrap">
      <div class="why rv">
        <div class="bg"><img {...pic('band')} sizes="100vw" alt="" loading="lazy" decoding="async" /></div>
        <canvas class="fx"></canvas>
        <div class="in">
          <div>
            <div class="eyebrow">Zašto MB Metamont</div>
            <h2>Brz odaziv i <em>kvalitetan rad.</em></h2>
            <p class="lead">Parketarski radovi u Rijeci i okolici, od prvog poziva do gotovog poda.</p>
            <a class="btn btn-p" href="#upit" data-usluga="ne-znam">Zatražite ponudu <span class="arr" set:html={arrow} /></a>
          </div>
          <div class="pts">
            {razlozi.map((r, i) => <div class="pt rv" style={`--d:${i * 0.1}s`}><i>{i + 1}</i><b>{r.b}</b><span>{r.s}</span></div>)}
          </div>
        </div>
      </div>
    </div></section>

    <!-- KAKO RADIMO -->
    <section class="sec" id="kako"><div class="wrap">
      <div class="head rv">
        <div class="eyebrow">Kako radimo</div>
        <h2>Od prvog poziva do gotovog poda <em>u četiri koraka.</em></h2>
      </div>
      <div class="tl">
        <span class="fill"></span>
        {koraci.map((k, i) => <div class="st"><i>{String(i + 1).padStart(2, '0')}</i><h3>{k.h}</h3><p>{k.p}</p></div>)}
      </div>
      <div class="after rv">
        <div><b>Imate pitanje o svom podu?</b><span>Pošaljite fotografiju na WhatsApp.</span></div>
        <a class="btn btn-wa" href={K.waHref} target="_blank" rel="noopener"><Fragment set:html={waIco} /> Pošaljite fotografiju</a>
      </div>
    </div></section>

    <!-- O NAMA -->
    <section class="sec" id="onama" style="padding-top:0"><div class="wrap"><div class="split">
      <div class="im rv">
        <img {...pic('onama')} sizes="(max-width:900px) 100vw, 540px" alt="Parketar pri radu" loading="lazy" decoding="async" />
        <div class="tag">MB Metamont · {K.mjesto}</div>
      </div>
      <div class="rv" style="--d:.1s">
        <div class="eyebrow">O nama</div>
        <h2>Parketarski radovi <em>u Rijeci i okolici.</em></h2>
        <p class="lead">MB Metamont d.o.o. izvodi parketarske radove na području Rijeke i Primorsko-goranske županije, od pripreme betonske podloge do postavljanja, brušenja i lakiranja parketa.</p>
        <p>Radove izvodi vlasnik osobno, a na većim objektima uz dodatnu pomoć. U Hrvatskoj radimo dvije godine.</p>
        <div class="kv">
          <div><b>Tvrtka</b><span>MB Metamont d.o.o.</span></div>
          <div><b>Područje rada</b><span>Rijeka i Primorsko-goranska županija</span></div>
          <div><b>Usluge</b><span>Parket, laminat, stepenice, beton</span></div>
          <div><b>Pozivi</b><span>Svaki dan, 6 – 22 h</span></div>
        </div>
        <a class="btn btn-p" href="#upit">Zatražite ponudu <span class="arr" set:html={arrow} /></a>
      </div>
    </div></div></section>

    <!-- PITANJA -->
    <section class="sec" id="pitanja" style="padding-top:0"><div class="wrap"><div class="faqw">
      <div class="side rv">
        <div class="eyebrow">Česta pitanja</div>
        <h2>Što nas klijenti <em>najčešće pitaju.</em></h2>
        <p class="lead">Niste pronašli odgovor? Nazovite nas svaki dan od 6 do 22 sata.</p>
        <a class="btn btn-d" href={K.telHref}><Fragment set:html={phoneIco} /> {K.tel}</a>
      </div>
      <div class="faq">
        {pitanja.map((p, i) => (
          <div class="q rv" style={`--d:${i * 0.06}s`}>
            <button aria-expanded="false">{p.q}<i>+</i></button>
            <div class="a"><p>{p.a}</p></div>
          </div>
        ))}
      </div>
    </div></div></section>

    <!-- KONTAKT -->
    <section id="kontakt"><div class="wrap"><div class="cbox rv">
      <div>
        <div class="eyebrow">Kontakt</div>
        <h2>Recite nam kakav <em>pod imate.</em></h2>
        <p class="lead">Nazovite ili pošaljite upit s nekoliko podataka o podu. Javit ćemo vam se i dogovoriti detalje.</p>
        <div class="ci">
          <a href={K.telHref}><i set:html={phoneIco} /><span><small>Telefon · {K.sati}</small><b>{K.tel}</b></span></a>
          <a href={K.waHref} target="_blank" rel="noopener"><i set:html={waIco} /><span><small>WhatsApp</small><b>{K.wa}</b></span></a>
          <a href={`mailto:${K.mail}`}><i set:html={mailIco} /><span><small>E-pošta</small><b>{K.mail}</b></span></a>
        </div>
        <div class="map" data-src="https://www.google.com/maps?q=Rijeka&output=embed">
          <div class="ph"><b>{K.podrucje} · Primorsko-goranska županija</b><button class="btn" type="button">Prikaži kartu</button></div>
        </div>
      </div>

      <form class="form" id="upit" novalidate>
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="Novi upit s web stranice mbmetamont.hr" />
        <input type="hidden" name="from_name" value="MB Metamont web stranica" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <h3>Zatražite ponudu</h3>
        <p>Bez obveze. Ispunite podatke i javit ćemo vam se u najkraćem roku.</p>
        <div class="f2">
          <div class="fld"><label for="ime">Ime i prezime *</label><input id="ime" name="ime" required autocomplete="name" /></div>
          <div class="fld"><label for="telefon">Telefon *</label><input id="telefon" name="telefon" type="tel" required autocomplete="tel" /></div>
        </div>
        <div class="f2">
          <div class="fld"><label for="email">E-pošta</label><input id="email" name="email" type="email" autocomplete="email" /></div>
          <div class="fld"><label for="lokacija">Mjesto</label><input id="lokacija" name="lokacija" placeholder="npr. Rijeka" /></div>
        </div>
        <div class="f2">
          <div class="fld"><label for="usluga">Što vam treba?</label>
            <select id="usluga" name="usluga"><option value="">Odaberite uslugu</option>{opcije.map(([v, t]) => <option value={v}>{t}</option>)}</select>
          </div>
          <div class="fld"><label for="povrsina">Površina (približno m²)</label><input id="povrsina" name="povrsina" inputmode="numeric" placeholder="npr. 60" /></div>
        </div>
        <div class="fld"><label for="poruka">Nekoliko riječi o podu</label><textarea id="poruka" name="poruka" placeholder="Vrsta poda, stanje, prostorije..."></textarea></div>
        <div class="btns">
          <button class="btn btn-p" type="submit" data-via="web"><Fragment set:html={mailIco} /> Pošaljite upit</button>
          <button class="btn btn-wa" type="submit" data-via="wa"><Fragment set:html={waIco} /> Pošaljite na WhatsApp</button>
        </div>
        <div class="err" role="alert">Slanje nije uspjelo. Pokušajte ponovno ili nas nazovite na {K.tel}.</div>
        <small>Vaše podatke koristimo isključivo za odgovor na upit.</small>
      </form>
    </div></div></section>
  </main>

  <footer><div class="wrap">
    <div class="fcols">
      <div>
        <a class="logo" href="/"><img src="/logo/logo-h.svg" alt="MB Metamont parket" width="250" height="37" /></a>
        <p>Postavljanje, brušenje, lakiranje i popravci parketa, drvene stepenice, laminat i priprema betona. {K.podrucje}.</p>
      </div>
      <div><h4>Usluge</h4><ul>
        <li><a href="#usluge">Postavljanje parketa</a></li><li><a href="#usluge">Brušenje i lakiranje</a></li>
        <li><a href="#usluge">Drvene stepenice</a></li><li><a href="#usluge">Laminat i priprema betona</a></li>
      </ul></div>
      <div><h4>MB Metamont</h4><ul>
        <li><a href="#onama">O nama</a></li><li><a href="#prije">Prije i poslije</a></li>
        <li><a href="#kako">Kako radimo</a></li><li><a href="#pitanja">Česta pitanja</a></li>
      </ul></div>
      <div><h4>Kontakt</h4><ul>
        <li><a href={K.telHref}>{K.tel}</a></li>
        <li><a href={`mailto:${K.mail}`}>{K.mail}</a></li>
        <li>{K.podrucje}</li>
      </ul></div>
    </div>
    <div class="fbot"><div>© {new Date().getFullYear()} MB Metamont d.o.o.</div><div>Parketarski radovi · {K.mjesto}</div></div>
  </div></footer>

  <!-- plutajući gumb (desktop) -->
  <div class="fl">
    <div class="fl-c" role="dialog" aria-label="Kontaktirajte nas">
      <button class="x" aria-label="Zatvori">×</button>
      <h4>Javite nam se</h4>
      <p>Pozivi svaki dan od 6 do 22 sata.</p>
      <div class="qc">
        <a class="btn btn-p" href={K.telHref}><Fragment set:html={phoneIco} /> {K.tel}</a>
        <a class="btn btn-wa" href={K.waHref} target="_blank" rel="noopener"><Fragment set:html={waIco} /> WhatsApp</a>
        <a class="btn btn-d" href={`mailto:${K.mail}`}><Fragment set:html={mailIco} /> E-pošta</a>
      </div>
    </div>
    <button class="fl-b" aria-label="Kontaktirajte nas"><Fragment set:html={phoneIco} /></button>
  </div>

  <!-- donja traka (mobitel) -->
  <div class="mbar">
    <a class="btn btn-p" href={K.telHref}><Fragment set:html={phoneIco} /> Nazovite</a>
    <a class="btn btn-wa" href={K.waHref} target="_blank" rel="noopener"><Fragment set:html={waIco} /> WhatsApp</a>
  </div>

  <script is:inline>
  (function(){
    var $=function(s,r){return (r||document).querySelector(s)}, $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
    var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* pojavljivanje pri skrolanju + vremenska crta */
    if('IntersectionObserver' in window&&!RM){
      var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add(x.target.classList.contains('tl')?'in':'on');io.unobserve(x.target)}})},{threshold:.15,rootMargin:'0px 0px -40px 0px'});
      $$('.rv,.tl').forEach(function(el){io.observe(el)});
    }else{$$('.rv').forEach(function(el){el.classList.add('on')});$$('.tl').forEach(function(el){el.classList.add('in')})}

    /* mobilni izbornik */
    var bg=$('.burger'), mn=$('.mnav');
    function mClose(){mn.classList.remove('open');document.body.classList.remove('lock');bg.setAttribute('aria-expanded',false)}
    if(bg&&mn){bg.addEventListener('click',function(){var o=mn.classList.toggle('open');document.body.classList.toggle('lock',o);bg.setAttribute('aria-expanded',o)});
    $$('a',mn).forEach(function(a){a.addEventListener('click',mClose)})}

    /* pitanja */
    $$('.q').forEach(function(q){var b=$('button',q),a=$('.a',q);b.addEventListener('click',function(){var o=q.classList.toggle('open');a.style.maxHeight=o?a.scrollHeight+'px':'0';b.setAttribute('aria-expanded',o)})});

    /* obrazac -> e-mail ili WhatsApp */
    var f=$('#upit'), via='web';
    $$('button[type=submit]',f).forEach(function(b){b.addEventListener('click',function(){via=b.getAttribute('data-via')})});
    f.addEventListener('submit',function(e){
      e.preventDefault();
      if(!f.checkValidity()){f.reportValidity();return}
      var d=new FormData(f), sel=$('#usluga');
      var usl=sel.value?sel.options[sel.selectedIndex].text:'';
      var lines=['Upit s web stranice','Ime: '+d.get('ime'),'Telefon: '+d.get('telefon')];
      if(d.get('email'))lines.push('E-pošta: '+d.get('email'));
      if(d.get('lokacija'))lines.push('Mjesto: '+d.get('lokacija'));
      if(usl)lines.push('Usluga: '+usl);
      if(d.get('povrsina'))lines.push('Površina: '+d.get('povrsina')+' m²');
      if(d.get('poruka'))lines.push('','Poruka: '+d.get('poruka'));
      var txt=lines.join('\n');
      if(via==='wa'){window.open('https://wa.me/38664264500?text='+encodeURIComponent(txt),'_blank');return}
      var btn=$('button[data-via=web]',f),err=$('.err',f),old=btn.innerHTML;
      err.style.display='none';btn.disabled=true;btn.textContent='Slanje...';
      var data={};d.forEach(function(v,k){data[k]=v});
      if(usl)data.usluga=usl;
      data.subject='Novi upit: '+d.get('ime')+(usl?' – '+usl:'');
      if(!data.email)delete data.email;
      fetch('https://api.web3forms.com/submit',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(data)})
        .then(function(r){return r.json()})
        .then(function(j){
          if(!j.success)throw new Error(j.message);
          var ok=document.createElement('div');ok.className='ok';
          ok.innerHTML='<b>Hvala na upitu!</b><span>Javit ćemo vam se u najkraćem roku.</span>';
          f.replaceWith(ok);
        })
        .catch(function(){btn.disabled=false;btn.innerHTML=old;err.style.display='block'});
    });

    /* odabir usluge iz kartica */
    $$('[data-usluga]').forEach(function(a){a.addEventListener('click',function(){var s=$('#usluga');if(s)s.value=a.getAttribute('data-usluga')})});

    /* plutajući gumb */
    var fl=$('.fl'),flb=$('.fl-b'),flx=$('.fl-c .x');
    function flClose(){if(fl)fl.classList.remove('open')}
    if(flb)flb.addEventListener('click',function(){fl.classList.toggle('open')});
    if(flx)flx.addEventListener('click',flClose);
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){flClose();if(mn&&mn.classList.contains('open'))mClose()}});

    /* karta na klik */
    var map=$('.map');if(map){$('.map .ph').addEventListener('click',function(){var fr=document.createElement('iframe');fr.loading='lazy';fr.referrerPolicy='no-referrer-when-downgrade';fr.src=map.getAttribute('data-src');fr.title='Karta';map.innerHTML='';map.appendChild(fr)})}

    /* iskrice */
    if(!RM){
      $$('canvas.fx').forEach(function(c){
        var ctx=c.getContext('2d'),ps=[],run=false,W,H,raf;
        function mk(init){return {x:Math.random()*W,y:init?Math.random()*H:H+10,r:Math.random()*1.4+.4,vy:-(Math.random()*.25+.08),vx:(Math.random()-.5)*.15,a:Math.random()*.6+.2,t:Math.random()*6.28}}
        function size(){W=c.width=c.offsetWidth;H=c.height=c.offsetHeight;ps=[];for(var i=0;i<Math.max(14,Math.round(W/60));i++)ps.push(mk(true))}
        function tick(){if(!run)return;ctx.clearRect(0,0,W,H);for(var i=0;i<ps.length;i++){var p=ps[i];p.t+=.02;p.x+=p.vx+Math.sin(p.t)*.1;p.y+=p.vy;if(p.y<-10||p.x<-10||p.x>W+10)ps[i]=mk(false);ctx.globalAlpha=p.a*(0.6+0.4*Math.sin(p.t*1.7));ctx.fillStyle='#f1d2a4';ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,6.28);ctx.fill()}raf=requestAnimationFrame(tick)}
        size();addEventListener('resize',size);
        new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){if(!run){run=true;tick()}}else{run=false;cancelAnimationFrame(raf)}})},{threshold:.05}).observe(c);
      });
    }

    /* prije / poslije klizač */
    $$('.ba').forEach(function(ba){var r=$('input',ba);function set(v){ba.style.setProperty('--p',v+'%')}
      r.addEventListener('input',function(){set(r.value);ba.dataset.t='1'});
      if(!RM&&'IntersectionObserver' in window){var o=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting&&!ba.dataset.t){o.disconnect();var t0=null;function st(t){if(ba.dataset.t)return;if(!t0)t0=t;var k=(t-t0)/2600;if(k>1){set(50);r.value=50;return}var v=50+Math.sin(k*Math.PI*2)*22;set(v.toFixed(1));r.value=v;requestAnimationFrame(st)}setTimeout(function(){requestAnimationFrame(st)},700)}})},{threshold:.5});o.observe(ba)}
    });

    /* sjena navigacije */
    var nav=$('.nav');function ns(){nav.classList.toggle('sc',scrollY>10)}ns();addEventListener('scroll',ns,{passive:true});
  })();
  </script>
</Layout>
