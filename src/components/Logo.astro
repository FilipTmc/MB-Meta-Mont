---
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
---
{full ? (
  <a href="#" aria-label="MB Metamont – početna">
    <img src="/logo.png" alt="MB Metamont" width="716" height="300" class="h-16 w-auto" />
  </a>
) : (
  <a href="#" class="flex items-center gap-3" aria-label="MB Metamont – početna">
    <img src="/logo-znak.png" alt="" width="507" height="160" class="h-8 w-auto" />
    <span class="hidden border-l border-ink/15 pl-3 text-[13px] font-bold uppercase leading-none tracking-[0.28em] text-ink sm:block">
      MB Metamont
    </span>
  </a>
)}
